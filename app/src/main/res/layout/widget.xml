<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingBottom="4dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/village" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Clash Ledger" android:textSize="15sp" android:textStyle="bold" android:fontFamily="sans-serif-condensed" android:textColor="#F2F5F7" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/widget_meta" android:maxLines="1" android:ellipsize="end" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="BUILDERS" android:textSize="9sp" android:textColor="#F2C46C" android:paddingTop="2dp"/>
        </LinearLayout>
        <ImageView android:id="@+id/refresh" android:layout_width="38dp" android:layout_height="38dp" android:src="@drawable/ic_refresh" android:padding="10dp" android:background="@drawable/widget_row_bg" android:contentDescription="Refresh widget"/>
    </LinearLayout>
    <ListView android:id="@+id/rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="2dp" android:scrollbars="none"/>
</LinearLayout>
