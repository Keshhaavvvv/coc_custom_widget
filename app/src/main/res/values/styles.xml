<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#F2C46C</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#0C121B</item>
        <item name="android:navigationBarColor">#0C121B</item>
        <item name="android:statusBarColor">#0C121B</item>
        <item name="android:alertDialogTheme">@style/LedgerDialog</item>
    </style>
    <style name="LedgerDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#F2C46C</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">#F2F5F7</item>
        <item name="android:textColorSecondary">#A4B0C1</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>
</resources>
